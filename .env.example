# Contact form — server-side only. These are never bundled into the browser
# (see api/_contact.js and the dev middleware in vite.config.js, which load
# them with an empty prefix so Vite keeps them unprefixed and unreachable from
# the client). In production, set the same names as Vercel Environment Variables.

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=

# Address that contact-form messages are delivered to
CONTACT_EMAIL=

# From address for outgoing mail. Optional — defaults to
# "TextUtils <onboarding@resend.dev>". Use a verified Resend domain in production.
EMAIL_FROM=
